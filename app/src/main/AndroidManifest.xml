<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- INTERNET is also required by Android for plain local-LAN sockets, not just real internet
         access - used for the LRCLIB lookup (План.md's opt-in network use) AND группа G's local
         HTTP server/client (Wi-Fi Drop, синхронизация, слушать вместе), which never leaves the
         LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Только для сканирования QR-кода как запасного пути для группы G, когда автопоиск
         устройств (NSD) ничего не находит. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".NamiApplication"
        android:label="Nami"
        android:icon="@drawable/ic_launcher_wave"
        android:roundIcon="@drawable/ic_launcher_wave"
        android:theme="@style/Theme.Nami">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="false">
            <!-- Predictive back (default-on at targetSdk 35) leaves the outgoing Compose
                 Navigation destination laid out and touchable underneath the incoming one,
                 a known class of bug with navigation-compose's AnimatedContent-based NavHost.
                 Disabled until that's fixed upstream; back falls through to the classic,
                 immediate-pop dispatcher our screens already assume. -->

            <!-- П.md §2 "Share-target на audio/*" - "поделиться" a file from Telegram/a browser/
                 a file manager straight into the library, one or several at once. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Icon picker (Settings): each alias targets the same MainActivity, just with its own
             launcher icon, exactly one enabled at a time (toggled at runtime via
             PackageManager.setComponentEnabledSetting); only the enabled one carries the
             LAUNCHER intent filter's effect. MainActivity itself has none, so exactly one icon
             ever shows up on the home screen/app drawer, never zero or two. -->
        <activity-alias
            android:name=".IconWave"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_wave"
            android:roundIcon="@drawable/ic_launcher_wave">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconKanji"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_kanji"
            android:roundIcon="@drawable/ic_launcher_kanji">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimalWhite"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal_white"
            android:roundIcon="@drawable/ic_launcher_minimal_white">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimalBlack"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal_black"
            android:roundIcon="@drawable/ic_launcher_minimal_black">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimalRed"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal_red"
            android:roundIcon="@drawable/ic_launcher_minimal_red">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlack"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_black"
            android:roundIcon="@drawable/ic_launcher_black">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Группа E "виджеты" (макет 4.15, 8 конфигураций) - отдельный receiver на каждую
             конфигурацию, т.к. Android-виджет-пикер показывает несколько записей на приложение
             как отдельные пункты, не один изменяемый по размеру виджет. -->
        <receiver android:name=".widget.NamiWidgetCompactReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_compact" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetPillReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_pill" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetSquarePlayerReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_square_player" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetArtOnlyReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_art_only" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetQueueReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_queue" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetNowPlayingTextReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_now_playing_text" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetShuffleReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_shuffle" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetSessionsReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_sessions" />
        </receiver>

        <!-- Группа D "карточка трека (экспорт-картинка)" - нужен content:// Uri чтобы поделиться
             сгенерированной картинкой в другое приложение (ACTION_SEND не примет file://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
