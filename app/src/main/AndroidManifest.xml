<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Нужно, чтобы система вообще показала диалог ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         (без разрешения intent просто падает с SecurityException). Само разрешение ничего не даёт,
         решение принимает пользователь в системном диалоге. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- INTERNET is also required by Android for plain local-LAN sockets, not just real internet
         access - used for the LRCLIB lookup (План.md's opt-in network use) AND группа G's local
         HTTP server/client (Wi-Fi Drop, синхронизация, слушать вместе), which never leaves the
         LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Wi-Fi Direct (группа G) - работает без роутера и без интернета, устройства сами
         договариваются о своей IP-подсети. CHANGE_WIFI_STATE нужен самому WifiP2pManager.
         NEARBY_WIFI_DEVICES (Android 13+) заменяет ACCESS_FINE_LOCATION для P2P-поиска -
         neverForLocation честен: своё местоположение приложение не вычисляет и не хранит. На
         Android 12 и ниже система всё равно требует ACCESS_FINE_LOCATION для discoverPeers(). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="33" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- Только для сканирования QR-кода как запасного пути для группы G, когда автопоиск
         устройств (NSD) ничего не находит. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Группа G целиком (Wi-Fi Drop, синхронизация, "слушать вместе" по LAN) ходит по обычному
         http:// на соседний телефон в той же сети. С targetSdk 28+ Android блокирует cleartext по
         умолчанию, и КАЖДЫЙ запрос группы G молча падал с "Cleartext HTTP traffic not permitted" -
         экран показывал "Не получилось скачать" и пустоту, будто устройство недоступно. HTTPS тут
         невозможен в принципе: сертификата у телефона в локалке нет и взять его негде. Наружу
         приложение ходит только по https (LRCLIB, ListenBrainz) - этот флаг их не понижает. -->
    <application
        android:usesCleartextTraffic="true"
        android:name=".NamiApplication"
        android:label="Nami"
        android:icon="@drawable/ic_launcher_wave"
        android:roundIcon="@drawable/ic_launcher_wave"
        android:theme="@style/Theme.Nami">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="false">
            <!-- Predictive back (default-on at targetSdk 35) leaves the outgoing Compose
                 Navigation destination laid out and touchable underneath the incoming one,
                 a known class of bug with navigation-compose's AnimatedContent-based NavHost.
                 Disabled until that's fixed upstream; back falls through to the classic,
                 immediate-pop dispatcher our screens already assume. -->

            <!-- П.md §2 "Share-target на audio/*" - "поделиться" a file from Telegram/a browser/
                 a file manager straight into the library, one or several at once. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Сопряжение с self-hosted сервером: QR-код мастера настройки открывается как
                 nami://auth?challenge=...&fp=sha256:...&port=...&hosts=ip1,ip2 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nami" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- Icon picker (Settings): each alias targets the same MainActivity, just with its own
             launcher icon, exactly one enabled at a time (toggled at runtime via
             PackageManager.setComponentEnabledSetting); only the enabled one carries the
             LAUNCHER intent filter's effect. MainActivity itself has none, so exactly one icon
             ever shows up on the home screen/app drawer, never zero or two. -->
        <activity-alias
            android:name=".IconWave"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_wave"
            android:roundIcon="@drawable/ic_launcher_wave">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconKanji"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_kanji"
            android:roundIcon="@drawable/ic_launcher_kanji">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimalWhite"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal_white"
            android:roundIcon="@drawable/ic_launcher_minimal_white">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimalBlack"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal_black"
            android:roundIcon="@drawable/ic_launcher_minimal_black">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimalRed"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal_red"
            android:roundIcon="@drawable/ic_launcher_minimal_red">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlack"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_black"
            android:roundIcon="@drawable/ic_launcher_black">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Группа E "виджеты" - три конфигурации, каждая свой receiver (Android-виджет-пикер
             показывает несколько записей на приложение как отдельные пункты). -->
        <receiver android:name=".widget.NamiWidgetCompactReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_compact" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetSquarePlayerReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_square_player" />
        </receiver>
        <receiver android:name=".widget.NamiWidgetSessionsReceiver" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_sessions" />
        </receiver>

        <!-- План.md §28 "Плитка быстрых настроек" - две отдельные плитки (играть/пауза и таймер
             сна), пользователь сам добавляет нужные в шторку. Обе объявлены ACTIVE_TILE - см.
             комментарий у каждой ниже и PlayerRepositoryImpl.startTileNudges. -->
        <service
            android:name=".tile.PlayPauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_play"
            android:label="Nami: играть/пауза"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- ACTIVE_TILE: система перестаёт сама звать onStartListening при открытии шторки,
                 зато плитка обновляется и пока шторка закрыта - будим её сами из
                 PlayerRepositoryImpl.startTileNudges на смену трека/паузы/минуты таймера. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".tile.SleepTimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sleep_timer"
            android:label="Nami: таймер сна"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- ACTIVE_TILE: система перестаёт сама звать onStartListening при открытии шторки,
                 зато плитка обновляется и пока шторка закрыта - будим её сами из
                 PlayerRepositoryImpl.startTileNudges на смену трека/паузы/минуты таймера. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Группа D "карточка трека (экспорт-картинка)" - нужен content:// Uri чтобы поделиться
             сгенерированной картинкой в другое приложение (ACTION_SEND не примет file://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
