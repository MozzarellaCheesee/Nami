<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NamiApplication"
        android:label="NAMI"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Nami">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="false">
            <!-- Predictive back (default-on at targetSdk 35) leaves the outgoing Compose
                 Navigation destination laid out and touchable underneath the incoming one,
                 a known class of bug with navigation-compose's AnimatedContent-based NavHost.
                 Disabled until that's fixed upstream; back falls through to the classic,
                 immediate-pop dispatcher our screens already assume. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
